# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Provide your MongoDB Atlas or local MongoDB connection URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/veloop_rewards?retryWrites=true&w=majority

# JWT Authentication (Minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_for_production_security

# Client Origin (CORS allowlist)
CLIENT_ORIGIN=http://localhost:5173

# Dev Tools (Allows dev time-travel and reset endpoints for testing/evaluation. MUST be false in production)
ENABLE_DEV_TOOLS=true
