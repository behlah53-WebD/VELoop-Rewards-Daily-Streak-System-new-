          }
        }
      ]
    },
    {
      "name": "04. Negative & Security Tests",
      "item": [
        {
          "name": "Locked Day (Early Claim Attempt) -> STILL_LOCKED",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/daily-streak/claim",
              "host": ["{{baseUrl}}"],
              "path": ["api", "daily-streak", "claim"]
            }
          }
        },
        {
          "name": "Fake Day Mismatch (Request Day 7 while on Day 2) -> DAY_MISMATCH",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/daily-streak/claim",
              "host": ["{{baseUrl}}"],
              "path": ["api", "daily-streak", "claim"]
            }
          }
        },
        {
          "name": "Fake Reward Payload -> Stripped by Zod",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": 2,\n  \"amount\": 99999,\n  \"currency\": \"USD\",\n  \"streak\": 100,\n  \"userId\": \"attackerId\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/daily-streak/claim",
              "host": ["{{baseUrl}}"],
              "path": ["api", "daily-streak", "claim"]
            }
          }
        },
        {
          "name": "Premature Confirmation -> CLAIM_NOT_READY",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"claimId\": \"{{claimId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/daily-streak/claim/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "daily-streak", "claim", "confirm"]
            }
          }
        },
        {
          "name": "Unauthenticated Request -> UNAUTHENTICATED (401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/daily-streak",
              "host": ["{{baseUrl}}"],
              "path": ["api", "daily-streak"]
            }
          }
        }
      ]
    },
